# Reading Room config
DATA_DIR=/data
# minutes between automatic feed polls
POLL_INTERVAL=30
# set 1 to disable all writes (read-only demo mode)
READONLY=0
# max images stored per article (0 = unlimited)
MAX_IMAGES=12
# request timeout (seconds) for feed + article fetches
FETCH_TIMEOUT=20
# override the outbound User-Agent (Reddit throttles generic UAs; a unique,
# descriptive string incl. your reddit username helps)
# USER_AGENT=ReadingRoom/0.1 by u/yourname
# Reddit app-only OAuth — lifts Reddit's ~1 req/min anon limit to ~100/min.
# Create a "script" app at https://www.reddit.com/prefs/apps, then set:
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
